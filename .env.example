# ==============================================================================
# Omni Movie Director (2026 Edition) - Environment Configuration
# ==============================================================================

# Google AI Studio / Gemini Enterprise API Key
GOOGLE_API_KEY="your-google-api-key-here"

# Model Tiering Matrix (2026 DeepMind Standards)
# STRICT NOTE: Legacy 3.1 models (gemini-3.1-*, veo-3.1-*) are strictly deprecated!
DIRECTOR_MODEL="gemini-4-argon"
FAST_MODEL="gemini-3.8-flash"
IMAGE_MODEL="gemini-3-pro-image"
VIDEO_MODEL="gemini-omni-1.1-flash-preview"

# Optional Cloud Project & Location
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"

# Execution Ergonomics
OMNI_DRY_RUN="false"
OMNI_OUTPUT_DIR="./outputs"
